import numpy as np
import matplotlib.pyplot as plt

# 1. Ֆունկցիա
def f(x):
    return x**3 + 3*x**2 - 9*x + 5

# 2. Սկզբնական տվյալներ
a, b = 0, 4
epsilon = 0.5

curr_a, curr_b = a, b

# Ոսկե հատույթի ճշգրիտ գործակիցներ
t1 = (3 - np.sqrt(5)) / 2      # ≈ 0.381966
t2 = (np.sqrt(5) - 1) / 2      # ≈ 0.618034

history_x = []
history_y = []

# Սկզբնական կետեր
x1 = curr_a + t1 * (curr_b - curr_a)
x2 = curr_a + t2 * (curr_b - curr_a)

f1 = f(x1)
f2 = f(x2)

print(f"{'Քայլ':<5} | {'a':<8} | {'b':<8} | {'b-a':<8} | {'x1':<8} | {'x2':<8}")
print("-" * 65)

step = 0

# 3. Ոսկե հատույթի ալգորիթմ
while (curr_b - curr_a) >= epsilon:
    step += 1

    history_x.extend([x1, x2])
    history_y.extend([f1, f2])

    print(f"{step:<5} | {curr_a:<8.4f} | {curr_b:<8.4f} | {curr_b - curr_a:<8.4f} | {x1:<8.4f} | {x2:<8.4f}")

    if f1 <= f2:
        curr_b = x2
        x2 = x1
        f2 = f1
        x1 = curr_a + t1 * (curr_b - curr_a)
        f1 = f(x1)
    else:
        curr_a = x1
        x1 = x2
        f1 = f2
        x2 = curr_a + t2 * (curr_b - curr_a)
        f2 = f(x2)

# Վերջնական միջակայք
step += 1
print(f"{step:<5} | {curr_a:<8.4f} | {curr_b:<8.4f} | {curr_b - curr_a:<8.4f} | {'-':<8} | {'-':<8}")

# Մոտավոր մինիմում
x_star = (curr_a + curr_b) / 2

print("-" * 65)
print(f"Մինիմումը մոտավորապես x* ≈ {x_star:.4f}")
print(f"f(x*) ≈ {f(x_star):.4f}")

# 4. Գրաֆիկ
x_plot = np.linspace(a, b, 1000)
y_plot = f(x_plot)

plt.figure()
plt.plot(x_plot, y_plot)
plt.scatter(history_x, history_y)
plt.scatter(x_star, f(x_star), marker='*')

plt.title(f"Ոսկե հատույթի եղանակ (epsilon = {epsilon})")
plt.xlabel("x")
plt.ylabel("f(x)")
plt.grid(True)
plt.show()
